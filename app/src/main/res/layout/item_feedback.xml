<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_white"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_marginBottom="16dp">

    <!-- Header: Question Number & Answer Status Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/txtItemNumber"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Pertanyaan 1"
            android:textColor="@color/primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtItemStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_score"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:text="Terjawab"
            android:textColor="@color/primary"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Question Text -->
    <TextView
        android:id="@+id/txtItemQuestion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ceritakan tentang diri Anda."
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:textStyle="bold"
        android:lineSpacingExtra="3dp"
        android:layout_marginBottom="12dp" />

    <!-- User Answer Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Jawaban Anda:"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/txtItemAnswer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_badge_role"
        android:padding="12dp"
        android:text="Jawaban yang diketik..."
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:lineSpacingExtra="2dp"
        android:layout_marginBottom="12dp" />

    <!-- Reference Guideline / Practice Tip -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="top"
        android:layout_marginBottom="8dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_lightbulb"
            android:contentDescription="Panduan"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/txtItemGuideline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Panduan Jawaban: Fokus pada pengalaman relevan."
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:lineSpacingExtra="2dp" />
    </LinearLayout>

    <!-- Explicit AI Status Placeholder Notice -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_banner_ai_placeholder"
        android:orientation="horizontal"
        android:padding="10dp"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_psychology"
            app:tint="@color/primary"
            android:contentDescription="Status AI"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/txtItemAiNotice"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Evaluasi AI: Belum tersedia (menunggu integrasi layanan AI)."
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>
