<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_white"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_marginBottom="16dp">

    <!-- Header: Question Number & Score Badge & Answer Status Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp">

        <TextView
            android:id="@+id/txtItemNumber"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Pertanyaan 1"
            android:textColor="@color/primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtItemScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_score"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:text="Skor: 85"
            android:textColor="@color/primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/txtItemStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_role"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:text="Terjawab"
            android:textColor="@color/primary"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Question Text -->
    <TextView
        android:id="@+id/txtItemQuestion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ceritakan tentang diri Anda."
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:textStyle="bold"
        android:lineSpacingExtra="3dp"
        android:layout_marginBottom="12dp" />

    <!-- User Answer Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Jawaban Anda:"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/txtItemAnswer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_badge_role"
        android:padding="12dp"
        android:text="Jawaban yang diketik..."
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:lineSpacingExtra="2dp"
        android:layout_marginBottom="12dp" />

    <!-- Feedback Section: Strengths / Analysis -->
    <LinearLayout
        android:id="@+id/layoutItemStrength"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="top"
        android:layout_marginBottom="8dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_check_circle"
            app:tint="@color/success"
            android:contentDescription="Kelebihan"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="2dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Analisis &amp; Kelebihan:"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="2dp" />

            <TextView
                android:id="@+id/txtItemStrength"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Poin utama sudah tersampaikan dengan jelas."
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:lineSpacingExtra="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Feedback Section: Improvement / Guideline -->
    <LinearLayout
        android:id="@+id/layoutItemImprovement"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="top"
        android:layout_marginBottom="8dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_lightbulb"
            app:tint="@color/warning"
            android:contentDescription="Saran Perbaikan"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="2dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Saran Perbaikan:"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="2dp" />

            <TextView
                android:id="@+id/txtItemGuideline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Panduan Jawaban: Fokus pada pengalaman relevan."
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:lineSpacingExtra="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Feedback Section: Sample / Ideal Recommendation Notice -->
    <LinearLayout
        android:id="@+id/layoutItemAiNotice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_banner_ai_placeholder"
        android:orientation="horizontal"
        android:padding="10dp"
        android:gravity="top">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_psychology"
            app:tint="@color/primary"
            android:contentDescription="Rekomendasi Jawaban"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="2dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rekomendasi Jawaban Ideal:"
                android:textColor="@color/primary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginBottom="2dp" />

            <TextView
                android:id="@+id/txtItemAiNotice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mulai dengan konteks peran, jelaskan tantangan yang dihadapi..."
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:lineSpacingExtra="2dp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
