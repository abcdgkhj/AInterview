<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollHome"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/white"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <!-- 1. Header (Dynamic Username Greeting + Subtitle, No Profile Icon) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/txtGreeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Halo, Kandidat!"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mari persiapkan karir impian Anda"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:layout_marginTop="3dp" />
            </LinearLayout>

            <!-- 2. Hero Banner Carousel (4 Slides) -->
            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/pagerHeroCarousel"
                android:layout_width="match_parent"
                android:layout_height="200dp" />

            <!-- Carousel Dot Indicators (4 dots) -->
            <LinearLayout
                android:id="@+id/layoutDotsIndicator"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:id="@+id/dot0"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/dot_indicator_selector"
                    android:contentDescription="Slide 1"
                    android:layout_marginHorizontal="3dp" />

                <ImageView
                    android:id="@+id/dot1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/dot_indicator_selector"
                    android:contentDescription="Slide 2"
                    android:layout_marginHorizontal="3dp" />

                <ImageView
                    android:id="@+id/dot2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/dot_indicator_selector"
                    android:contentDescription="Slide 3"
                    android:layout_marginHorizontal="3dp" />

                <ImageView
                    android:id="@+id/dot3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/dot_indicator_selector"
                    android:contentDescription="Slide 4"
                    android:layout_marginHorizontal="3dp" />

            </LinearLayout>

            <!-- 3. Tombol Konfigurasi Wawancara -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnInterviewConfig"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Konfigurasi Wawancara"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                app:icon="@drawable/ic_settings"
                app:iconTint="@color/white"
                app:iconGravity="textStart"
                app:iconPadding="10dp"
                app:backgroundTint="@color/primary"
                app:cornerRadius="12dp"
                android:layout_marginBottom="22dp" />

            <!-- 4. Pilihan Jenis Wawancara Section Header -->
            <TextView
                android:id="@+id/txtSectionCategories"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pilihan Jenis Wawancara"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold"
                android:layout_marginBottom="14dp" />

            <!-- Card 1: Wawancara Umum -->
            <LinearLayout
                android:id="@+id/cardInterviewUmum"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white"
                android:orientation="vertical"
                android:padding="18dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_badge_role"
                        android:padding="11dp"
                        android:src="@drawable/ic_psychology"
                        app:tint="@color/primary"
                        android:contentDescription="Wawancara Umum"
                        android:layout_marginEnd="14dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Wawancara Umum"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                    <!--    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Latihan pertanyaan kepribadian dan pengalaman kerja."
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:lineSpacingExtra="2dp"
                            android:layout_marginTop="3dp" /> -->
                    </LinearLayout>

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/text_muted"
                        android:contentDescription="Mulai"
                        android:layout_marginStart="8dp" />
                </LinearLayout>

               <!-- <TextView
                android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_score"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:text="Langsung Mulai • Pertanyaan Kepribadian &amp; Situasi"
                    android:textColor="@color/primary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginTop="12dp" />
                -->

            </LinearLayout>

            <!-- Card 2: Wawancara Teknis -->
            <LinearLayout
                android:id="@+id/cardInterviewTeknis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_white"
                android:orientation="vertical"
                android:padding="18dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_badge_role"
                        android:padding="11dp"
                        android:src="@drawable/ic_code"
                        app:tint="@color/accent"
                        android:contentDescription="Wawancara Teknis"
                        android:layout_marginEnd="14dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Wawancara Teknis"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                    <!--    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Latihan pertanyaan sesuai bidang keahlian."
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:lineSpacingExtra="2dp"
                            android:layout_marginTop="3dp" /> -->
                    </LinearLayout>

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/text_muted"
                        android:contentDescription="Pilih Bidang"
                        android:layout_marginStart="8dp" />
                </LinearLayout>

             <!--    <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_role"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:text="Pilih Bidang • 10 Bidang Keahlian Pilihan"
                    android:textColor="@color/accent"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginTop="12dp" /> -->

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Divider Line -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <!-- 4. Bottom Navigation View (Beranda, Riwayat, Profil) -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavHome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:elevation="8dp"
        app:itemIconTint="@color/bottom_nav_color_selector"
        app:itemTextColor="@color/bottom_nav_color_selector"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu" />

</LinearLayout>
