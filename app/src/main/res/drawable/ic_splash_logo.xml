<?xml version="1.0" encoding="utf-8"?>
<!--
    Dedicated Splash Screen Icon for Android 12+ (API 31+).
    
    Android 12 SplashScreen uses a 160dp viewport with a 115dp circular mask.
    The AInterview logo is a transparent PNG centered inside a 96dp x 96dp layer item.
    At 96dp, the maximum corner distance of the logo to center is ~56.2dp < 57.5dp,
    ensuring zero clipping by the 115dp circular mask.
    
    This resource is used exclusively for windowSplashScreenAnimatedIcon.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="96dp"
        android:height="96dp"
        android:gravity="center"
        android:drawable="@drawable/ic_ainterview_logo" />
</layer-list>
