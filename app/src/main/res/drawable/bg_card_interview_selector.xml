<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="150"
    android:exitFadeDuration="350">
    <!-- Selected / Highlighted State: Soft light-blue background with thin blue outline -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#EFF6FF" />
            <corners android:radius="16dp" />
            <stroke
                android:width="1.5dp"
                android:color="@color/primary" />
        </shape>
    </item>
    <!-- Default Normal State: Pure white card with thin gray stroke -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_card" />
            <corners android:radius="16dp" />
            <stroke
                android:width="1dp"
                android:color="@color/surface_stroke" />
        </shape>
    </item>
</selector>

