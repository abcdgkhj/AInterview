<?xml version="1.0" encoding="utf-8"?>
<!--
    Pre-Android 12 Splash Window Background.
    
    Combines the pure white background with the centered transparent AInterview logo
    at 96dp (matching the Android 12+ splash icon size) for a seamless, identical
    splash experience across all Android versions.
    
    Used as android:windowBackground in Theme.InterviewAI.Splash.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pure white background (#FFFFFF) -->
    <item android:drawable="@drawable/bg_splash_screen" />
    <!-- Centered transparent AInterview logo at 96dp -->
    <item
        android:width="96dp"
        android:height="96dp"
        android:gravity="center"
        android:drawable="@drawable/ic_ainterview_logo" />
</layer-list>
